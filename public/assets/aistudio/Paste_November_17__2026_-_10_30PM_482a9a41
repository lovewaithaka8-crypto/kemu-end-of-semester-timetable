      { code: "ITCR 216", title: "Mobile Application Development I", date: "2026-12-04", day: "Friday, 4 December 2026", time: "2:00 PM – 5:00 PM", campus: "MTC", venue: "LR1", invigilator: "Crispin", practical: false }
    ];

    const campusNames = { "NRB": "Nairobi", "MSA": "Mombasa", "MTC": "Meru" };
    let selected = new Set();
    let currentCampus = "ALL";
    let currentType = "ALL";

    function setCampusFilter(campus) {
      currentCampus = campus;
      document.querySelectorAll('[data-campus]').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.campus === campus);
      });
      filterUnits();
    }

    function setTypeFilter(type) {
      currentType = type;
      document.querySelectorAll('[data-type]').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.type === type);
      });
      filterUnits();
    }

    function updateLivePracticalNotice() {
      const notice = document.getElementById("livePracticalNotice");
      const listEl = document.getElementById("livePracticalList");
      const practicals = exams.filter(e => selected.has(e.code) && e.practical);
      if (practicals.length === 0) {
        notice.classList.remove("show");
        return;
      }
      let html = "<ul style='margin:6px 0 0 16px;'>";
      practicals.forEach(e => {
        html += "<li><strong>" + e.code + "</strong> – " + e.day.split(',')[0] + " at " + e.time + " (" + (campusNames[e.campus] || e.campus) + ")</li>";
      });
      html += "</ul>";
      listEl.innerHTML = html;
      notice.classList.add("show");
    }

    function renderUnits(filter = "") {
      const list = document.getElementById("unitList");
      const q = filter.toLowerCase().trim();
      let filtered = exams.filter(e => {
        const matchesSearch = e.code.toLowerCase().includes(q) || e.title.toLowerCase().includes(q);
        const matchesCampus = currentCampus === "ALL" || e.campus === currentCampus;
        const matchesType = currentType === "ALL" ||
          (currentType === "PRACTICAL" && e.practical) ||
          (currentType === "THEORY" && !e.practical);
        return matchesSearch && matchesCampus && matchesType;
      });
      if (filtered.length === 0) {
        list.innerHTML = '<div class="empty-state"><h3>No units found</h3><p>Try different filters or search term</p></div>';
        return;
      }
      list.innerHTML = filtered.map(e => {
        const isSelected = selected.has(e.code);
        const typeBadge = e.practical
          ? '<span class="badge badge-practical">PRACTICAL</span>'
          : '<span class="badge badge-theory">THEORY</span>';
        const campusBadge = '<span class="badge badge-campus">' + (campusNames[e.campus] || e.campus) + '</span>';
        return '<label class="unit-item ' + (isSelected ? 'selected' : '') + '">' +
          '<input type="checkbox" ' + (isSelected ? 'checked' : '') +
          ' onchange="toggleUnit(\'' + e.code + '\', this.checked)">' +
          '<div class="unit-info">' +
            '<div class="unit-code">' + e.code + ' ' + typeBadge + ' ' + campusBadge + '</div>' +
            '<div class="unit-title">' + e.title + '</div>' +
            '<div class="unit-details">' +
              '<span>📅 ' + e.day.split(',')[0] + '</span>' +
              '<span>🕒 ' + e.time + '</span>' +
              '<span>📍 ' + e.campus + ' – ' + e.venue + '</span>' +
            '</div></div></label>';
      }).join('');
    }

    function toggleUnit(code, checked) {
      if (checked) selected.add(code);
      else selected.delete(code);
      updateCount();
      updateLivePracticalNotice();
      renderUnits(document.getElementById("searchInput").value);
    }

    function updateCount() {
      document.getElementById("selectedCount").textContent = selected.size;
      document.getElementById("generateBtn").disabled = selected.size === 0;
    }

    function clearSelection() {
      selected.clear();
      updateCount();
      updateLivePracticalNotice();
      renderUnits(document.getElementById("searchInput").value);
    }

    function filterUnits() {
      renderUnits(document.getElementById("searchInput").value);
    }

    function generateTimetable() {
      if (selected.size === 0) return;
      const myExams = exams.filter(e => selected.has(e.code));
      myExams.sort((a, b) => {
        if (a.date !== b.date) return a.date.localeCompare(b.date);
        return a.time.localeCompare(b.time);
      });

      const clashMap = {};
      myExams.forEach(e => {
        const key = e.date + "|" + e.time;
        if (!clashMap[key]) clashMap[key] = [];
        clashMap[key].push(e);
      });
      const clashGroups = Object.values(clashMap).filter(g => g.length > 1);
      const clashCodes = new Set();
      clashGroups.forEach(g => g.forEach(e => clashCodes.add(e.code)));
      const practicals = myExams.filter(e => e.practical);

      document.getElementById("summaryCards").innerHTML =
        '<div class="summary-card"><div class="num">' + myExams.length + '</div><div class="label">Total Exams</div></div>' +
        '<div class="summary-card practical"><div class="num">' + practicals.length + '</div><div class="label">Practical Papers</div></div>' +
        '<div class="summary-card clash"><div class="num">' + clashGroups.length + '</div><div class="label">Time Collisions</div></div>';

      const pAlert = document.getElementById("practicalAlert");
      const pDetails = document.getElementById("practicalDetails");
      if (practicals.length > 0) {
        let html = "<ul>";
        practicals.forEach(e => {
          html += "<li><strong>" + e.code + "</strong> – " + e.day.split(',')[0] + " at <strong>" + e.time + "</strong> (" + (campusNames[e.campus] || e.campus) + ", " + e.venue + ")</li>";
        });
        html += "</ul><p style='margin-top:8px;font-size:0.85rem;'>Make sure you are prepared for these practical sessions.</p>";
        pDetails.innerHTML = html;
        pAlert.classList.add("show");
      } else {
        pAlert.classList.remove("show");
      }

      const alertEl = document.getElementById("clashAlert");
      const detailsEl = document.getElementById("clashDetails");
      if (clashGroups.length > 0) {
        let details = "<ul>";
        clashGroups.forEach(group => {
          const time = group[0].time;
          const day = group[0].day.split(',')[0];
          const units = group.map(e => '<strong>' + e.code + '</strong> (' + (campusNames[e.campus] || e.campus) + ')').join(" & ");
          details += '<li><strong>' + day + '</strong> at ' + time + ': ' + units + '</li>';
        });
        details += '</ul><p style="margin-top:8px;font-size:0.85rem;">These exams are at the same time. If they are on different campuses, confirm which campus you belong to.</p>';
        detailsEl.innerHTML = details;
        alertEl.classList.add("show");
      } else {
        alertEl.classList.remove("show");
      }

      const byDay = {};
      myExams.forEach(e => {
        if (!byDay[e.day]) byDay[e.day] = [];
        byDay[e.day].push(e);
      });

      let html = "";
      for (const [day, list] of Object.entries(byDay)) {
        html += '<div class="day-group"><div class="day-title">' + day.split(',')[0] +
          '<span class="day-date">' + (day.split(',')[1] || '').trim() + '</span></div>';
        list.forEach(e => {
          const isClash = clashCodes.has(e.code);
          const typeBadge = e.practical
            ? '<span class="badge badge-practical">PRACTICAL</span>'
            : '<span class="badge badge-theory">THEORY</span>';
          const campusBadge = '<span class="badge badge-campus">' + (campusNames[e.campus] || e.campus) + '</span>';
          const cardClass = (isClash ? 'clash ' : '') + (e.practical ? 'practical-card' : '');
          html += '<div class="exam-card ' + cardClass + '">' +
            '<div class="card-top"><div class="time-badge">' + e.time + '</div>' +
            '<div style="display:flex;gap:6px;flex-wrap:wrap;">' + typeBadge + campusBadge + '</div></div>' +
            '<div class="unit-code">' + e.code + '</div>' +
            '<div class="unit-title">' + e.title + '</div>' +
            '<div class="meta-grid">' +
              '<div><strong>Campus</strong>' + (campusNames[e.campus] || e.campus) + ' (' + e.campus + ')</div>' +
              '<div><strong>Venue</strong>' + e.venue + '</div>' +
              '<div><strong>Invigilator</strong>' + e.invigilator + '</div>' +
            '</div></div>';
        });
        html += '</div>';
      }
      document.getElementById("timetableContainer").innerHTML = html;
      showPage('results');
    }

    function showPage(pageId) {
      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      document.getElementById(pageId).classList.add('active');
      document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
      if (pageId === 'home') document.querySelectorAll('.nav-btn')[0].classList.add('active');
      else document.querySelectorAll('.nav-btn')[1].classList.add('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    renderUnits();
  </script>
